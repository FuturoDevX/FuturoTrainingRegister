# Copy to .env and fill in before running

PORT=3001
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite file path
DB_PATH=./data/training.db

# Set to "production" on the live server — enables HTTPS-only session cookies and refuses
# to boot without SESSION_SECRET. Leave unset locally.
# NODE_ENV=production

# Nightly rotating snapshots (services/backup.js). Both optional — sensible defaults apply:
# BACKUP_DIR defaults to a "backups" folder next to the database; BACKUP_KEEP defaults to 14.
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=14

# Employment Hero (KeyPay-based payroll API) — same credential pattern already validated
# in Dashboard/_pipeline/employment_hero/eh_payroll_credentials.json and Dashboard/PMS-App.
# Used only to keep the staff/centre list up to date — no pay data is pulled here.
EH_API_KEY=
EH_BASE_URL=
EH_BUSINESS_ID=

# Default Admin account created on first seed — change the password immediately after first login
ADMIN_EMAIL=christo.kruger@futuro.nsw.edu.au
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
