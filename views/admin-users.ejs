<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Admin — Users — Futuro Training Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include("partials/header", { user }) %>
  <main class="container">
    <h1>Admin</h1>
    <%- include("partials/admin-tabs", { activeTab }) %>

    <section class="card">
      <h2>Users</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Centre</th><th>Active</th><th class="sticky-col">Actions</th></tr></thead>
          <tbody>
            <% var roleLabels = { admin: "Admin", centre_manager: "Centre Manager" }; %>
            <% users.forEach(function(u) { %>
              <tr>
                <td><%= u.full_name %></td>
                <td><%= u.email %></td>
                <td><%= roleLabels[u.role] || u.role %></td>
                <td><%= u.location_name || "—" %></td>
                <td><%= u.active ? "Yes" : "No" %></td>
                <td class="actions-cell sticky-col">
                  <div class="row-actions">
                    <details class="inline-reveal">
                      <summary class="row-action">Password</summary>
                      <form method="POST" action="/admin/users/<%= u.id %>/password" class="password-reset-form">
                        <input type="text" name="password" placeholder="New password" minlength="8" required>
                        <button type="submit" class="button btn-sm">Save</button>
                      </form>
                    </details>
                    <a href="/admin/users/<%= u.id %>/edit" class="row-action">Edit</a>
                    <form method="POST" action="/admin/users/<%= u.id %>/toggle" class="inline">
                      <% if (u.active) { %>
                        <button type="submit" class="row-action danger">Deactivate</button>
                      <% } else { %>
                        <button type="submit" class="row-action">Reactivate</button>
                      <% } %>
                    </form>
                    <% if (u.id !== user.id) { %>
                      <form method="POST" action="/admin/users/<%= u.id %>/delete" class="inline" onsubmit="return confirm('Permanently delete this login? This cannot be undone.');">
                        <button type="submit" class="row-action danger">Delete</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <details>
        <summary>+ New login</summary>
        <form method="POST" action="/admin/users" class="form-grid">
          <label>Full name<input type="text" name="full_name" required></label>
          <label>Email<input type="email" name="email" required></label>
          <label>Role
            <select name="role" required>
              <option value="centre_manager">Centre Manager</option>
              <option value="admin">Admin</option>
            </select>
          </label>
          <label>Centre (Centre Manager only)
            <select name="location_id">
              <option value="">—</option>
              <% locations.forEach(function(l) { %><option value="<%= l.id %>"><%= l.name %></option><% }) %>
            </select>
          </label>
          <label>Password<input type="text" name="password" placeholder="At least 8 characters" minlength="8" required></label>
          <button type="submit" class="full">Create login</button>
        </form>
      </details>
    </section>
  </main>
</body>
</html>
