<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Admin — Users — Futuro Training Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include("partials/header", { user }) %>
  <main class="container">
    <h1>Admin</h1>
    <%- include("partials/admin-tabs", { activeTab }) %>

    <section class="card">
      <h2>Users</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Centre</th><th>Active</th><th class="sticky-col">Actions</th></tr></thead>
          <tbody>
            <% users.forEach(function(u) { %>
              <tr>
                <td><%= u.full_name %></td>
                <td><%= u.email %></td>
                <td><%= u.role %></td>
                <td><%= u.location_name || "—" %></td>
                <td><%= u.active ? "Yes" : "No" %></td>
                <td class="actions-cell sticky-col">
                  <details class="inline-reveal">
                    <summary class="icon-link" title="Set new password" aria-label="Set new password">🔑</summary>
                    <form method="POST" action="/admin/users/<%= u.id %>/password" class="password-reset-form">
                      <input type="text" name="password" placeholder="New password" minlength="8" required>
                      <button type="submit" class="icon-link" title="Save" aria-label="Save">✓</button>
                    </form>
                  </details>
                  <form method="POST" action="/admin/users/<%= u.id %>/toggle" class="inline">
                    <% if (u.active) { %>
                      <button type="submit" class="icon-link danger" title="Deactivate" aria-label="Deactivate">🚫</button>
                    <% } else { %>
                      <button type="submit" class="icon-link" title="Reactivate" aria-label="Reactivate">✅</button>
                    <% } %>
                  </form>
                  <a href="/admin/users/<%= u.id %>/edit" class="icon-link" title="Edit" aria-label="Edit">✎</a>
                  <% if (u.id !== user.id) { %>
                    <form method="POST" action="/admin/users/<%= u.id %>/delete" class="inline" onsubmit="return confirm('Permanently delete this login? This cannot be undone.');">
                      <button type="submit" class="icon-link danger" title="Delete" aria-label="Delete">🗑</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <details>
        <summary>+ New login</summary>
        <form method="POST" action="/admin/users" class="form-grid">
          <label>Full name<input type="text" name="full_name" required></label>
          <label>Email<input type="email" name="email" required></label>
          <label>Role
            <select name="role" required>
              <option value="centre_manager">Centre Manager</option>
              <option value="admin">Admin</option>
            </select>
          </label>
          <label>Centre (Centre Manager only)
            <select name="location_id">
              <option value="">—</option>
              <% locations.forEach(function(l) { %><option value="<%= l.id %>"><%= l.name %></option><% }) %>
            </select>
          </label>
          <label>Password<input type="text" name="password" placeholder="Demo1234! if left blank"></label>
          <button type="submit" class="full">Create login</button>
        </form>
      </details>
    </section>
  </main>
</body>
</html>
