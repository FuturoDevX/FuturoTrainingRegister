<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Admin — Org Roles — Futuro Training Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include("partials/header", { user }) %>
  <main class="container">
    <h1>Admin</h1>
    <%- include("partials/admin-tabs", { activeTab }) %>

    <section class="card">
      <h2>Org-wide roles</h2>
      <p class="muted">
        These sit above centre level and feed the development responsibility chains — e.g. a
        Centre Manager's supporting leaders are the Operations Manager + General Manager, and
        an Educational Leader's are Quality &amp; Compliance + their Centre Manager.
      </p>
      <form method="POST" action="/admin/org-roles" class="form-grid">
        <% orgRoleDefs.forEach(function(def) { %>
          <label><%= def.label %>
            <select name="<%= def.key %>">
              <option value="">— not set —</option>
              <% staff.forEach(function(s) { %>
                <option value="<%= s.id %>" <%= s.id === holders[def.key] ? "selected" : "" %>><%= s.full_name %><%= s.location_name ? " (" + s.location_name + ")" : "" %></option>
              <% }) %>
            </select>
          </label>
        <% }) %>
        <button type="submit" class="full">Save org roles</button>
      </form>
    </section>
  </main>
</body>
</html>
