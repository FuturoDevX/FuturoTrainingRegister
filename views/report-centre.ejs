<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= location.name %> Training Report — Futuro Training Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include("partials/header", { user }) %>
  <main class="container">
    <% if (user.role === "admin") { %><p><a href="/report">&larr; All centres</a></p><% } %>
    <div class="row-between">
      <h1><%= location.name %> — Training Report</h1>
      <a class="button" href="/report/centre/<%= location.id %>.csv">Export CSV</a>
    </div>

    <div class="table-scroll">
      <table>
        <thead><tr><th>Name</th><th>Position</th><th>Sessions Attended</th><th>Total Hours</th><th class="sticky-col"></th></tr></thead>
        <tbody>
          <% rows.forEach(function(s) { %>
            <tr>
              <td><%= s.full_name %></td>
              <td><%= s.position_title || "—" %></td>
              <td><%= s.sessions_attended %></td>
              <td><%= s.total_hours %></td>
              <td class="sticky-col"><a href="/report/person/<%= s.id %>" class="icon-link" title="Individual report" aria-label="Individual report">📄</a></td>
            </tr>
          <% }) %>
          <% if (rows.length === 0) { %>
            <tr><td colspan="5" class="muted">No active staff at this centre.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
