<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Admin — Backup — Futuro Training Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include("partials/header", { user }) %>
  <main class="container">
    <h1>Admin</h1>
    <%- include("partials/admin-tabs", { activeTab }) %>

    <section class="card">
      <h2>Backup</h2>
      <p class="muted">
        Render's disk has no automatic backups — this downloads a complete, self-contained
        copy of the database as it is right now. Worth doing every so often, and definitely
        before any big change (e.g. a fresh EH sync or bulk data entry).
      </p>
      <a class="button" href="/admin/export">Download database backup</a>
    </section>
  </main>
</body>
</html>
