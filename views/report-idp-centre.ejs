<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= location.name %> IDP Report — Futuro Training Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include("partials/header", { user }) %>
  <main class="container">
    <h1>Reports</h1>
    <%- include("partials/report-tabs", { activeTab }) %>
    <% if (isAdmin) { %><p><a href="/report/idp">&larr; All centres</a></p><% } %>

    <section class="card">
      <h2><%= location.name %> — development plans</h2>
      <div class="stat-row">
        <div class="stat"><div class="stat-num"><%= centre.pct %>%</div><div class="stat-label">have an active IDP</div></div>
        <div class="stat"><div class="stat-num"><%= centre.active %></div><div class="stat-label">active</div></div>
        <div class="stat"><div class="stat-num"><%= centre.total %></div><div class="stat-label">active staff</div></div>
        <div class="stat"><div class="stat-num"><%= centre.none_count %></div><div class="stat-label">no IDP</div></div>
      </div>
    </section>

    <section class="card">
      <h2>By room</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Room</th><th>Coverage</th><th>Active</th><th>Draft</th><th>Completed</th><th>No IDP</th><th>Staff</th></tr></thead>
          <tbody>
            <% rooms.forEach(function(r) { %>
              <tr>
                <td><%= r.group_name %></td>
                <td>
                  <div class="coverage"><div class="coverage-bar" style="width: <%= r.pct %>%"></div><span class="coverage-pct"><%= r.pct %>%</span></div>
                </td>
                <td><%= r.active %></td>
                <td><%= r.draft %></td>
                <td><%= r.completed %></td>
                <td><%= r.none_count %></td>
                <td><%= r.total %></td>
              </tr>
            <% }) %>
            <% if (rooms.length === 0) { %><tr><td colspan="7" class="muted">No active staff at this centre.</td></tr><% } %>
          </tbody>
        </table>
      </div>
      <p class="muted">Open <a href="/development/plans<%= isAdmin ? '?centre=' + location.id : '' %>">Development → Plans</a> to manage individual plans.</p>
    </section>
  </main>
</body>
</html>
