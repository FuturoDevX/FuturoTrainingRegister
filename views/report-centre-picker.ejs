<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Reports — Futuro Training Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include("partials/header", { user }) %>
  <main class="container">
    <h1>Reports</h1>
    <%- include("partials/report-tabs", { activeTab }) %>
    <p class="muted">Pick a centre to see its staff and training hours.</p>
    <ul class="link-list">
      <% locations.forEach(function(l) { %>
        <li><a href="/report/centre/<%= l.id %>"><%= l.name %></a></li>
      <% }) %>
    </ul>
  </main>
</body>
</html>
