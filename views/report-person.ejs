<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= staffMember.full_name %> — Staff profile</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include("partials/header", { user }) %>
  <main class="container">
    <p class="no-print"><a href="/report/centre/<%= staffMember.location_id %>">&larr; <%= staffMember.location_name %> report</a></p>
    <div class="row-between">
      <h1><%= staffMember.full_name %></h1>
      <button class="button no-print" onclick="window.print()">Print</button>
    </div>
    <p class="muted"><%= staffMember.position_title || "—" %> &middot; <%= staffMember.location_name %></p>

    <!-- Development plan -->
    <%
      var goalStatusLabel = { not_started: "Not started", in_progress: "In progress", achieved: "Achieved", dropped: "Dropped" };
    %>
    <h2>Development plan</h2>
    <% if (!idp) { %>
      <p class="muted">No IDP on record.</p>
    <% } else { %>
      <p>
        <span class="badge status-<%= idp.status %>"><%= idp.status %></span>
        <% if (idp.review_date) { %><span class="muted">Next review: <%= idp.review_date %></span><% } %>
      </p>
      <% if (idp.focus) { %><p><%= idp.focus %></p><% } %>
      <% if (idp.strengths || idp.aspirations) { %>
        <dl class="idp-foundation">
          <% if (idp.strengths) { %><dt>Strengths</dt><dd><%= idp.strengths %></dd><% } %>
          <% if (idp.aspirations) { %><dt>Aspirations</dt><dd><%= idp.aspirations %></dd><% } %>
        </dl>
      <% } %>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Area for development</th><th>Goal</th><th>Target</th><th>NQS</th><th>Status</th></tr></thead>
          <tbody>
            <% goals.forEach(function(g) { %>
              <tr>
                <td><%= g.area_title || "—" %></td>
                <td><%= g.title %></td>
                <td><%= g.target_date || "—" %></td>
                <td><% if (g.nqs_element_code) { %><span class="badge nqs-tag" title="<%= nqs.elementLabel(g.nqs_element_code) %>"><%= g.nqs_element_code %></span><% } else { %>—<% } %></td>
                <td><span class="badge status-<%= g.status %>"><%= goalStatusLabel[g.status] %></span></td>
              </tr>
            <% }) %>
            <% if (goals.length === 0) { %><tr><td colspan="5" class="muted">No goals recorded.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (typeof idpHistory !== "undefined" && idpHistory.length) { %>
      <h2>Development history</h2>
      <p class="muted">Completed plans, most recent first.</p>
      <% idpHistory.forEach(function(h) { %>
        <div class="history-cycle">
          <div class="row-between">
            <strong>Completed <%= h.completed_at ? h.completed_at.slice(0,10) : "—" %></strong>
            <span class="muted"><%= h.achieved_count %>/<%= h.goal_count %> goals achieved</span>
          </div>
          <% if (h.focus) { %><p class="muted" style="margin:4px 0 6px"><%= h.focus %></p><% } %>
          <% if (h.goals.length) { %>
            <ul class="history-goals">
              <% h.goals.forEach(function(g) { %><li><span><%= g.title %></span> <span class="badge status-<%= g.status %>"><%= goalStatusLabel[g.status] %></span></li><% }) %>
            </ul>
          <% } %>
        </div>
      <% }) %>
    <% } %>

    <h2>Training</h2>
    <p><strong><%= totalHours %> hours</strong> of training attended (all-time)</p>

    <div class="table-scroll">
      <table>
        <thead><tr><th>Date</th><th>Session</th><th>Provider</th><th>Hours</th><th>NQS</th></tr></thead>
        <tbody>
          <% sessions.forEach(function(s) { %>
            <tr>
              <td><%= s.session_date %></td>
              <td><%= s.title %></td>
              <td><%= s.provider || "—" %></td>
              <td><%= s.hours %></td>
              <td>
                <% if (!s.nqsCodes || s.nqsCodes.length === 0) { %>—<% } %>
                <% (s.nqsCodes || []).forEach(function(code) { %><span class="badge nqs-tag" title="<%= nqs.elementLabel(code) %>"><%= code %></span><% }) %>
              </td>
            </tr>
          <% }) %>
          <% if (sessions.length === 0) { %>
            <tr><td colspan="5" class="muted">No training attended yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
