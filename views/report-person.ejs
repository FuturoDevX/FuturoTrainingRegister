<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= staffMember.full_name %> — Training Report</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include("partials/header", { user }) %>
  <main class="container">
    <p class="no-print"><a href="/report/centre/<%= staffMember.location_id %>">&larr; <%= staffMember.location_name %> report</a></p>
    <div class="row-between">
      <h1><%= staffMember.full_name %></h1>
      <button class="button no-print" onclick="window.print()">Print</button>
    </div>
    <p class="muted"><%= staffMember.position_title || "—" %> &middot; <%= staffMember.location_name %></p>
    <p><strong><%= totalHours %> hours</strong> of training attended (all-time)</p>

    <table>
      <thead><tr><th>Date</th><th>Session</th><th>Provider</th><th>Hours</th><th>Attended</th><th>NQS</th></tr></thead>
      <tbody>
        <% sessions.forEach(function(s) { %>
          <tr>
            <td><%= s.session_date %></td>
            <td><%= s.title %></td>
            <td><%= s.provider || "—" %></td>
            <td><%= s.hours %></td>
            <td><%= s.attended ? "Yes" : "No" %></td>
            <td>
              <% if (!s.nqsCodes || s.nqsCodes.length === 0) { %>—<% } %>
              <% (s.nqsCodes || []).forEach(function(code) { %><span class="badge nqs-tag" title="<%= nqs.elementLabel(code) %>"><%= code %></span><% }) %>
            </td>
          </tr>
        <% }) %>
        <% if (sessions.length === 0) { %>
          <tr><td colspan="6" class="muted">No training sessions recorded yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </main>
</body>
</html>
