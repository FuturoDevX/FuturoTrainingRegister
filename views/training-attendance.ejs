<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Attendance — <%= session.title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include("partials/header", { user }) %>
  <main class="container">
    <p><a href="/training">&larr; Back to sessions</a></p>
    <h1><%= session.title %></h1>
    <p class="muted">
      <%= session.session_date %> &middot; Hosted at <%= session.location_name %> &middot; <%= session.hours %> hours<% if (session.provider) { %> &middot; <%= session.provider %><% } %>
      <% if (session.all_centres) { %><span class="badge">All centres</span><% } %>
    </p>
    <% if (session.all_centres) { %>
      <p class="muted">Open to all centres — each centre's manager marks their own staff's attendance here, whichever centre it's hosted at.</p>
    <% } %>
    <% if (session.nqs.length > 0) { %>
      <p class="muted">
        NQS:
        <% session.nqs.forEach(function(el) { %><span class="badge nqs-tag" title="<%= el.name %>"><%= el.code %></span><% }) %>
      </p>
    <% } %>

    <% if (centreSummary) { %>
      <table class="summary-table">
        <thead><tr><th>Centre</th><th>Active staff</th><th>Marked attended</th><th></th></tr></thead>
        <tbody>
          <% centreSummary.forEach(function(c) { %>
            <tr class="<%= c.id === viewLocation.id ? 'current-row' : '' %>">
              <td><%= c.name %></td>
              <td><%= c.staff_count %></td>
              <td><%= c.attended_count %></td>
              <td><a href="/training/<%= session.id %>/attendance?centre=<%= c.id %>">View / mark</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <h2>Marking for: <%= viewLocation.name %></h2>
    <form method="POST" action="/training/<%= session.id %>/attendance">
      <% if (isAdmin) { %><input type="hidden" name="location_id" value="<%= viewLocation.id %>"><% } %>
      <table>
        <thead><tr><th class="attend-col"><% if (staff.length) { %><label class="markall"><input type="checkbox" id="attend-all"> all</label><% } else { %>Attended<% } %></th><th>Name</th><th>Position</th></tr></thead>
        <tbody>
          <% staff.forEach(function(s) { %>
            <tr>
              <td><input type="checkbox" name="attended" value="<%= s.id %>" <%= attendedSet.has(s.id) ? "checked" : "" %>></td>
              <td><%= s.full_name %></td>
              <td><%= s.position_title || "—" %></td>
            </tr>
          <% }) %>
          <% if (staff.length === 0) { %>
            <tr><td colspan="3" class="muted">No active staff at <%= viewLocation.name %>.</td></tr>
          <% } %>
        </tbody>
      </table>
      <button type="submit">Save attendance</button>
    </form>
  </main>
  <script>
    // Header "all" checkbox toggles every row; it also reflects the rows' combined state.
    (function () {
      var all = document.getElementById("attend-all");
      if (!all) return;
      var boxes = Array.prototype.slice.call(document.querySelectorAll('input[name="attended"]'));
      function sync() { all.checked = boxes.length > 0 && boxes.every(function (b) { return b.checked; }); }
      all.addEventListener("change", function () { boxes.forEach(function (b) { b.checked = all.checked; }); });
      boxes.forEach(function (b) { b.addEventListener("change", sync); });
      sync();
    })();
  </script>
</body>
</html>
